{
  "name": "agentdoctor",
  "productName": "AgentDoctor",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first diagnostics and reversible configuration repairs for AI coding tools.",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/serve.mjs",
    "desktop": "electron .",
    "setup:engine": "node scripts/setup-engine.mjs",
    "setup:desktop": "node scripts/setup-desktop.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "npm run build && npm test",
    "package:source": "node scripts/package-source.mjs",
    "package:windows": "node scripts/package-windows.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@iarna/toml": "^2.2.5",
    "diff": "^8.0.2",
    "extract-zip": "^2.0.1",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^39.0.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.1"
  },
  "license": "MIT"
}
